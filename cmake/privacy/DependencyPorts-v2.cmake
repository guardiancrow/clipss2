function(clipss2_verify_dependency_source root package)
    set(contract "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependency-diagnostics-v2.json")
    file(SHA256 "${contract}" contract_hash)
    string(TOUPPER "${contract_hash}" contract_hash)
    if(NOT contract_hash STREQUAL "F9CDAB5B5875208DAEB38B6527962E6D4250A030F3D45A5D8FA81F221143B21A")
        message(FATAL_ERROR "Unapproved v2 diagnostic contract")
    endif()
    file(READ "${contract}" spec)
    string(JSON profile GET "${spec}" profile)
    if(NOT profile STREQUAL "v2" OR NOT package MATCHES "^(highway|libjxl)$")
        message(FATAL_ERROR "Unknown v2 dependency source selection")
    endif()
    string(JSON count LENGTH "${spec}" patches)
    math(EXPR last "${count} - 1")
    set(matched 0)
    foreach(index RANGE 0 ${last})
        string(JSON owner GET "${spec}" patches ${index} package)
        if(owner STREQUAL package)
            math(EXPR matched "${matched} + 1")
            string(JSON path GET "${spec}" patches ${index} path)
            string(JSON expected GET "${spec}" patches ${index} afterSha256)
            file(SHA256 "${root}/${path}" actual)
            string(TOUPPER "${actual}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Unapproved v2 dependency postimage")
            endif()
        endif()
    endforeach()
    if((package STREQUAL "highway" AND NOT matched EQUAL 1)
       OR (package STREQUAL "libjxl" AND NOT matched EQUAL 4))
        message(FATAL_ERROR "Incomplete v2 postimage selection")
    endif()
endfunction()
