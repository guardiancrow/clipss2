if(NOT libjpeg-turbo_VERSION STREQUAL "3.2.1")
    message(FATAL_ERROR "SEC-MAINT-3D: unexpected TurboJPEG package")
endif()
find_package(JPEG REQUIRED)
find_package(SPNG 0.7.4 EXACT CONFIG REQUIRED)
file(REAL_PATH "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}" jpeg_install)
file(REAL_PATH "${JPEG_LIBRARY_RELEASE}" jpeg_module_import)
if(NOT TARGET JPEG::JPEG OR NOT jpeg_module_import STREQUAL "${jpeg_install}/lib/jpeg.lib")
    message(FATAL_ERROR "SEC-MAINT-3D: JPEG::JPEG does not bind the candidate v6b library")
endif()

function(clipss2_check_3d_shared target library dll)
    get_target_property(actual_import "${target}" IMPORTED_IMPLIB_RELEASE)
    get_target_property(actual_runtime "${target}" IMPORTED_LOCATION_RELEASE)
    file(REAL_PATH "${actual_import}" actual_import)
    file(REAL_PATH "${actual_runtime}" actual_runtime)
    if(NOT actual_import STREQUAL "${jpeg_install}/lib/${library}"
       OR NOT actual_runtime STREQUAL "${jpeg_install}/bin/${dll}")
        message(FATAL_ERROR "SEC-MAINT-3D: ${target} does not select the candidate shared package")
    endif()
endfunction()
clipss2_check_3d_shared(libjpeg-turbo::turbojpeg turbojpeg.lib turbojpeg.dll)
clipss2_check_3d_shared(libjpeg-turbo::jpeg jpeg.lib jpeg62.dll)
clipss2_check_3d_shared(spng::spng spng.lib spng.dll)
