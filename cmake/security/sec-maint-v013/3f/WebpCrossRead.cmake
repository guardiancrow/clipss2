file(MAKE_DIRECTORY "${evidence}")
set(results "")
foreach(fixture IN ITEMS tiny flat text detail photo noise alpha odd wide full-hd 4k)
    foreach(encoder IN ITEMS reference candidate)
        set(decoder reference)
        if(encoder STREQUAL "reference")
            set(decoder candidate)
        endif()
        set(output "${evidence}/${encoder}-${fixture}.webp")
        execute_process(COMMAND "${${encoder}}" encode "${fixture}" "${output}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${${decoder}}" decode "${fixture}" "${output}" COMMAND_ERROR_IS_FATAL ANY)
        file(SHA256 "${output}" ${encoder}_digest)
    endforeach()
    if(NOT reference_digest STREQUAL candidate_digest)
        message(FATAL_ERROR "SEC-MAINT-3F: WebP bitstream differs for ${fixture}")
    endif()
    string(APPEND results "${fixture} ${candidate_digest}\n")
endforeach()
file(WRITE "${evidence}/bitstream-sha256.txt" "${results}")
